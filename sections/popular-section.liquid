<section class="popular-searches" style="background-color: {{ section.settings.bg_color }};">
  <div class="popular-searches__container section section--page-width">
    {% if section.settings.heading != blank %}
      <h2 class="popular-searches__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="popular-searches__groups">
      {% for block in section.blocks %}
        {% if block.type == 'search_group' %}
          <div class="popular-searches__group" {{ block.shopify_attributes }}>
            {% if block.settings.group_title != blank %}
              <h3 class="popular-searches__group-title">{{ block.settings.group_title }}</h3>
            {% endif %}

            <div class="popular-searches__links">
              {% for i in (1..8) %}
                {% assign link_text_key = 'link_text_' | append: i %}
                {% assign link_url_key = 'link_url_' | append: i %}
                {% assign link_text = block.settings[link_text_key] %}
                {% assign link_url = block.settings[link_url_key] %}

                {% if link_text != blank %}
                  <a href="{{ link_url | default: '#' }}" class="popular-searches__link">{{ link_text }}</a>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .popular-searches {
    padding: 40px 0;
  }

  .popular-searches__heading {
    font-size: 26px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 24px 0;
  }

  .popular-searches__groups {
    display: flex;
    flex-direction: column;
  }

  .popular-searches__group {
    padding: 16px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .popular-searches__group:last-child {
    border-bottom: none;
  }

  .popular-searches__group-title {
    font-size: 14px;
    font-weight: 400;
    color: #8a8a8a;
    margin: 0 0 8px 0;
  }

  .popular-searches__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 6px;
  }

  .popular-searches__link {
    font-size: 14px;
    color: #7a7a7a;
    text-decoration: none;
    white-space: nowrap;
  }

  .popular-searches__link:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .popular-searches__link:not(:last-child)::after {
    content: '|';
    margin: 0 8px;
    color: #d0d0d0;
  }

  @media screen and (max-width: 749px) {
    .popular-searches__heading {
      font-size: 22px;
    }

    .popular-searches__link {
      font-size: 13px;
    }

    .popular-searches__link:not(:last-child)::after {
      margin: 0 6px;
    }
  }
{% endstylesheet %}

