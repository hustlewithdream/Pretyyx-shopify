<section class="loved-worn" data-section-id="{{ section.id }}">
  <div class="section section--page-width">
    <div class="loved-worn__container">

      <div class="loved-worn__left">
        {% comment %} <p class="loved-worn__eyebrow">{{ section.settings.eyebrow }}</p> {% endcomment %}
        <h2 class="loved-worn__headline">{{ section.settings.headline }}</h2>
        <p class="loved-worn__subcopy">{{ section.settings.subcopy }}</p>

        <div class="loved-worn__stats">
          <span class="loved-worn__rating-number">{{ section.settings.rating_number }}</span>
          <span class="loved-worn__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <svg viewBox="0 0 20 20" class="star" style="--d: {{ forloop.index0 | times: 80 }}ms"><path d="M10 1.5l2.47 5.4 5.93.6-4.47 4.02 1.28 5.88L10 14.7l-5.21 2.7 1.28-5.88L1.6 7.5l5.93-.6L10 1.5z"/></svg>
            {% endfor %}
          </span>
          <span class="loved-worn__count">{{ section.settings.customer_count }}</span>
        </div>

        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_link | default: '#' }}" class="loved-worn__cta">
            <span>{{ section.settings.cta_text }}</span>
            <svg viewBox="0 0 24 12" class="loved-worn__cta-arrow"><path d="M0 6H23M23 6L18 1M23 6L18 11" stroke="currentColor" stroke-width="1" fill="none"/></svg>
          </a>
        {% endif %}
      </div>

      <div class="loved-worn__right">

        <div class="loved-worn__switcher" role="tablist" aria-label="Review category">
          {% for block in section.blocks %}
            {% if block.type == 'category' %}
              <button
                type="button"
                class="loved-worn__switch-btn{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-category-target="cat-{{ section.id }}-{{ forloop.index }}"
              >{{ block.settings.category_label }}</button>
            {% endif %}
          {% endfor %}
        </div>

        <div class="loved-worn__stage">
          {% for block in section.blocks %}
            {% if block.type == 'category' %}
              <div
                class="loved-worn__panel{% if forloop.first %} is-active{% endif %}"
                id="cat-{{ section.id }}-{{ forloop.index }}"
                {{ block.shopify_attributes }}
              >

                <div class="loved-worn__featured">
                  <svg viewBox="0 0 20 20" class="loved-worn__featured-stars" aria-hidden="true">
                    <path d="M10 1.5l2.47 5.4 5.93.6-4.47 4.02 1.28 5.88L10 14.7l-5.21 2.7 1.28-5.88L1.6 7.5l5.93-.6L10 1.5z"/>
                  </svg>
                  <blockquote class="loved-worn__featured-quote">
                    &ldquo;{{ block.settings.featured_quote }}&rdquo;
                  </blockquote>
                  <div class="loved-worn__featured-meta">
                    <span class="loved-worn__avatar">{{ block.settings.featured_name | slice: 0, 1 }}</span>
                    <div class="loved-worn__meta-text">
                      <span class="loved-worn__name">— {{ block.settings.featured_name }}</span>
                      {% if block.settings.verified %}
                        <span class="loved-worn__verified">Verified Purchase{% if block.settings.category_label != blank %} · {{ block.settings.category_label }}{% endif %}</span>
                      {% endif %}
                    </div>
                  </div>
                </div>

                <div class="loved-worn__snippets">
                  {% for i in (1..3) %}
                    {% assign snippet_key = 'snippet_' | append: i %}
                    {% assign name_key = 'snippet_name_' | append: i %}
                    {% assign snippet_text = block.settings[snippet_key] %}
                    {% assign snippet_name = block.settings[name_key] %}
                    {% if snippet_text != blank %}
                      <div class="loved-worn__snippet snippet-{{ i }}">
                        <span class="loved-worn__snippet-stars" aria-hidden="true">★★★★★</span>
                        <p>&ldquo;{{ snippet_text }}&rdquo;</p>
                        {% if snippet_name != blank %}<span class="loved-worn__snippet-name">— {{ snippet_name }}</span>{% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>

              </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.querySelector('[data-section-id="{{ section.id }}"]');
    if (!root) return;

    var buttons = root.querySelectorAll('.loved-worn__switch-btn');
    var panels = root.querySelectorAll('.loved-worn__panel');

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-category-target');

        buttons.forEach(function (b) {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        panels.forEach(function (p) {
          if (p.id === target) {
            p.classList.remove('is-active');
            void p.offsetWidth;
            p.classList.add('is-active');
          } else {
            p.classList.remove('is-active');
          }
        });
      });
    });

    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });
      observer.observe(root);
    } else {
      root.classList.add('is-visible');
    }
  })();
</script>

{% stylesheet %}
  .loved-worn {
    background: #fdf0e9;
    padding: 96px 0;
    overflow: hidden;
  }

  .loved-worn__container {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: start;
  }

  /* ---------- LEFT ---------- */

  .loved-worn__left {
    padding-top: 24px;
    position: sticky;
    top: 80px;
  }

  /* .loved-worn__eyebrow {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #a68a5b;
    margin: 0 0 20px 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  } */

  .loved-worn__headline {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    font-size: clamp(34px, 4.2vw, 54px);
    line-height: 1.12;
    color: #2b2622;
    margin: 0 0 24px 0;
    letter-spacing: -0.01em;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s ease 0.1s, transform 0.8s ease 0.1s;
  }

  .loved-worn__subcopy {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 16px;
    line-height: 1.6;
    color: #746a5e;
    max-width: 360px;
    margin: 0 0 40px 0;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s ease 0.2s, transform 0.8s ease 0.2s;
  }

  .loved-worn__stats {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 44px;
    flex-wrap: wrap;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s ease 0.3s, transform 0.8s ease 0.3s;
  }

  .loved-worn__rating-number {
    font-family: Georgia, serif;
    font-size: 28px;
    color: #2b2622;
  }

  .loved-worn__stars {
    display: inline-flex;
    gap: 3px;
  }

  .loved-worn__stars .star {
    width: 15px;
    height: 15px;
    fill: #b89b6a;
    transform: scale(0);
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) var(--d, 0ms);
  }

  .loved-worn.is-visible .loved-worn__stars .star,
  .loved-worn__container.is-visible .loved-worn__stars .star {
    transform: scale(1);
  }

  .loved-worn__count {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 13px;
    color: #948a7d;
    letter-spacing: 0.02em;
  }

  .loved-worn__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 14px;
    letter-spacing: 0.03em;
    color: #2b2622;
    text-decoration: none;
    border-bottom: 1px solid #2b2622;
    padding-bottom: 4px;
    width: fit-content;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.8s ease 0.4s, transform 0.8s ease 0.4s, gap 0.3s ease, border-color 0.3s ease;
  }

  .loved-worn__cta:hover {
    gap: 16px;
    border-color: #a68a5b;
    color: #a68a5b;
  }

  .loved-worn__cta-arrow {
    width: 20px;
    height: 10px;
  }

  /* ---------- RIGHT ---------- */

  .loved-worn__right {
    position: relative;
  }

  .loved-worn__switcher {
    display: inline-flex;
    gap: 4px;
    margin-bottom: 48px;
    padding: 4px;
    border: 1px solid #ddd2bf;
    border-radius: 100px;
    opacity: 0;
    transition: opacity 0.8s ease 0.2s;
  }

  .loved-worn__switch-btn {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: none;
    border: none;
    padding: 10px 22px;
    border-radius: 100px;
    color: #948a7d;
    cursor: pointer;
    transition: background 0.4s ease, color 0.4s ease;
  }

  .loved-worn__switch-btn.is-active {
    background: #2b2622;
    color: #f7f3ec;
  }

  .loved-worn__stage {
    position: relative;
    min-height: 460px;
  }

  .loved-worn__panel {
    position: relative;
    display: none;
  }

  .loved-worn__panel.is-active {
    display: block;
    animation: panelIn 0.6s ease both;
  }

  @keyframes panelIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .loved-worn__featured {
    position: relative;
    max-width: 560px;
    padding: 8px 0 8px 32px;
    border-left: 1px solid #d8ccb4;
    margin-bottom: 56px;
  }

  .loved-worn__featured-stars {
    width: 20px;
    height: 20px;
    fill: #b89b6a;
    margin-bottom: 20px;
  }

  .loved-worn__featured-quote {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.42;
    color: #2b2622;
    margin: 0 0 28px 0;
    font-style: italic;
  }

  .loved-worn__featured-meta {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .loved-worn__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e7ddc9;
    color: #6b5a3a;
    font-family: Georgia, serif;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .loved-worn__meta-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .loved-worn__name {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 14px;
    color: #2b2622;
  }

  .loved-worn__verified {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #a68a5b;
  }

  .loved-worn__snippets {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    max-width: 720px;
  }

  .loved-worn__snippet {
    background: transparent;
    padding: 0;
    opacity: 0;
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .loved-worn.is-visible .loved-worn__snippet,
  .loved-worn__container.is-visible .loved-worn__snippet {
    opacity: 1;
    transform: translate(0, 0) !important;
  }

  .loved-worn__snippet.snippet-1 { transform: translateY(18px); transition-delay: 0.25s; }
  .loved-worn__snippet.snippet-2 { transform: translateY(30px); transition-delay: 0.4s; margin-top: 28px; }
  .loved-worn__snippet.snippet-3 { transform: translateY(18px); transition-delay: 0.55s; }

  .loved-worn__snippet-stars {
    display: block;
    font-size: 10px;
    letter-spacing: 2px;
    color: #b89b6a;
    margin-bottom: 10px;
  }

  .loved-worn__snippet p {
    font-family: var(--font-body-family, 'Helvetica Neue', Arial, sans-serif);
    font-size: 14.5px;
    line-height: 1.55;
    color: #4a4238;
    margin: 0 0 10px 0;
  }

  .loved-worn__snippet-name {
    font-family: Georgia, serif;
    font-size: 12px;
    font-style: italic;
    color: #948a7d;
  }

  /* ---------- Trigger visibility via IO on container ---------- */

  /* .loved-worn.is-visible .loved-worn__eyebrow, */
  .loved-worn.is-visible .loved-worn__headline,
  .loved-worn.is-visible .loved-worn__subcopy,
  .loved-worn.is-visible .loved-worn__stats,
  .loved-worn.is-visible .loved-worn__cta,
  .loved-worn.is-visible .loved-worn__switcher {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---------- Reduced motion ---------- */

  @media (prefers-reduced-motion: reduce) {
    /* .loved-worn__eyebrow, */
    .loved-worn__headline,
    .loved-worn__subcopy,
    .loved-worn__stats,
    .loved-worn__cta,
    .loved-worn__switcher,
    .loved-worn__snippet,
    .loved-worn__stars .star {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* ---------- Tablet ---------- */

  @media screen and (max-width: 989px) {
    .loved-worn__container {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .loved-worn__left {
      position: static;
    }

    .loved-worn__subcopy {
      max-width: 100%;
    }

    .loved-worn__snippets {
      grid-template-columns: repeat(3, minmax(220px, 1fr));
      overflow-x: auto;
      padding-bottom: 12px;
      -webkit-overflow-scrolling: touch;
    }

    .loved-worn__snippet.snippet-2 {
      margin-top: 0;
    }
  }

  /* ---------- Mobile: dedicated composition ---------- */

  @media screen and (max-width: 749px) {
    .loved-worn {
      padding: 64px 0;
    }

    .loved-worn__container {
      padding: 0 20px;
      gap: 36px;
    }

    .loved-worn__headline {
      font-size: 30px;
    }

    .loved-worn__right {
      display: flex;
      flex-direction: column;
    }

    .loved-worn__switcher {
      order: 2;
      margin: 32px 0 32px 0;
      align-self: flex-start;
    }

    .loved-worn__stage {
      order: 1;
      min-height: 0;
    }

    .loved-worn__featured {
      padding-left: 20px;
      margin-bottom: 32px;
    }

    .loved-worn__featured-quote {
      font-size: 22px;
    }

    .loved-worn__snippets {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 78%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      margin: 0 -20px;
      padding: 0 20px 8px 20px;
    }

    .loved-worn__snippet {
      scroll-snap-align: start;
      background: #ffffff;
      padding: 20px;
      border-radius: 2px;
    }

    .loved-worn__snippet.snippet-2 {
      margin-top: 0;
    }
  }
{% endstylesheet %}

