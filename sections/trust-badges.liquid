<section class="trust-badges" style="background-color: {{ section.settings.bg_color }};">
  <div class="trust-badges__container page-width">
    {% for block in section.blocks %}
      {% if block.type == 'badge' %}
        <div class="trust-badges__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="trust-badges__link">{% endif %}

          <div class="trust-badges__icon">
            {% case block.settings.icon %}
              {% when 'returns' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 4V9H9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M4.5 15C5.83 18.5 9.13 21 13 21C17.97 21 22 16.97 22 12C22 7.03 17.97 3 13 3C9.13 3 5.83 5.5 4.5 9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 6H14V16H2V6Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M14 9H17.5L21 12.5V16H14V9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <circle cx="6" cy="18.5" r="1.75" stroke="currentColor" stroke-width="1.2"/>
                  <circle cx="17.5" cy="18.5" r="1.75" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              {% when 'gift' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="9" width="18" height="4" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <rect x="4.5" y="13" width="15" height="8" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M12 9V21" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M12 9C12 9 8.5 9 7.5 6.8C6.8 5.2 8 3.8 9.3 4.5C11 5.4 12 9 12 9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M12 9C12 9 15.5 9 16.5 6.8C17.2 5.2 16 3.8 14.7 4.5C13 5.4 12 9 12 9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                </svg>
              {% when 'warranty' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3L19.5 6V11C19.5 16 16.5 19.8 12 21C7.5 19.8 4.5 16 4.5 11V6L12 3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M9 12L11 14L15.5 9.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'secure' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="5" y="10.5" width="14" height="10" rx="1" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                  <path d="M8 10.5V7.5C8 5 9.8 3 12 3C14.2 3 16 5 16 7.5V10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.2"/>
                  <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M5.5 5.5L9 9M19 5.5L15 9M5.5 18.5L9 15M19 18.5L15 15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            {% endcase %}
          </div>

          {% if block.settings.text != blank %}
            <p class="trust-badges__text">{{ block.settings.text }}</p>
          {% endif %}

          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .trust-badges {
    padding: 32px 0;
  }

  .trust-badges__container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: stretch;
  }

  .trust-badges__item {
    flex: 1;
    display: flex;
    height: 150px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 0 24px;
    border-left: 1px solid #e5e5e5;
  }

  .trust-badges__item:first-child {
    border-left: none;
  }

  .trust-badges__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    gap: 12px;
  }

  .trust-badges__icon {
    width: 28px;
    height: 28px;
    color: #1a1a1a;
  }

  .trust-badges__icon svg {
    width: 100%;
    height: 100%;
  }

  .trust-badges__text {
    font-size: 13px;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .trust-badges__container {
      flex-wrap: wrap;
      row-gap: 24px;
    }

    .trust-badges__item {
      flex: 1 1 50%;
      border-left: none;
      padding: 0 12px;
    }

    .trust-badges__item:nth-child(odd) {
      border-right: 1px solid #e5e5e5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "shopify-section--trust-badges",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "returns", "label": "Returns" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "gift", "label": "Gift" },
            { "value": "warranty", "label": "Warranty" },
            { "value": "secure", "label": "Secure" },
            { "value": "support", "label": "Support" }
          ],
          "default": "returns"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free 30-day returns"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trust badges",
      "blocks": [
        {
          "type": "badge",
          "settings": { "icon": "returns", "text": "Free 30-day returns" }
        },
        {
          "type": "badge",
          "settings": { "icon": "shipping", "text": "Free shipping on orders $75+" }
        },
        {
          "type": "badge",
          "settings": { "icon": "gift", "text": "Gift packaging available" }
        },
        {
          "type": "badge",
          "settings": { "icon": "warranty", "text": "Complimentary 1-year warranty" }
        }
      ]
    }
  ]
}
{% endschema %}
